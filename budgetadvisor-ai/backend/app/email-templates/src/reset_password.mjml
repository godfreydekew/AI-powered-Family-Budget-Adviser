<mjml>
  <mj-head>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-text font-size="14px" line-height="24px" color="#374151" />
    </mj-attributes>
    <mj-style>
      .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #9ca3af; }
      .cta:hover { background-color: #4f46e5 !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">

    <!-- Top spacer -->
    <mj-section padding="32px 0 0 0" background-color="#f3f4f6">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <!-- Logo header -->
    <mj-section background-color="#1e1b4b" border-radius="16px 16px 0 0" padding="28px 40px">
      <mj-column>
        <mj-text align="left" font-size="18px" font-weight="600" color="#ffffff" line-height="1">
          <span style="color:#818cf8;">•</span> budgetadvisor.ai
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Card body -->
    <mj-section background-color="#ffffff" padding="48px 40px 32px 40px">
      <mj-column>

        <!-- Icon -->
        <mj-image
          src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/89/Lock_Flat_Icon.svg/64px-Lock_Flat_Icon.svg.png"
          width="48px"
          align="left"
          padding="0 0 24px 0"
          alt=""
        />

        <!-- Heading -->
        <mj-text font-size="22px" font-weight="600" color="#111827" line-height="30px" padding="0 0 12px 0">
          Reset your password
        </mj-text>

        <!-- Body copy -->
        <mj-text padding="0 0 8px 0" color="#6b7280">
          Hi {{ username }},
        </mj-text>
        <mj-text padding="0 0 32px 0" color="#374151">
          We received a request to reset the password for your budgetadvisor.ai account. Click the button below to choose a new password. This link expires in <strong style="color:#111827;">{{ valid_hours }} hours</strong>.
        </mj-text>

        <!-- CTA button -->
        <mj-button
          align="left"
          background-color="#6366f1"
          color="#ffffff"
          border-radius="10px"
          font-size="14px"
          font-weight="600"
          inner-padding="14px 28px"
          href="{{ link }}"
          css-class="cta"
          padding="0 0 32px 0"
        >
          Reset password →
        </mj-button>

        <!-- Divider -->
        <mj-divider border-color="#e5e7eb" border-width="1px" padding="0 0 24px 0" />

        <!-- Fallback link -->
        <mj-text css-class="label" padding="0 0 8px 0">
          Or copy this link into your browser
        </mj-text>
        <mj-text font-size="12px" color="#6b7280" line-height="20px" padding="0 0 24px 0">
          <a href="{{ link }}" style="color:#6366f1; word-break:break-all;">{{ link }}</a>
        </mj-text>

        <!-- Ignore notice -->
        <mj-text font-size="13px" color="#9ca3af" padding="0">
          If you didn't request a password reset you can safely ignore this email — your password will remain unchanged.
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" border-radius="0 0 16px 16px" padding="24px 40px" border-top="1px solid #e5e7eb">
      <mj-column>
        <mj-text font-size="12px" color="#9ca3af" line-height="20px" align="center">
          © 2025 budgetadvisor.ai · All rights reserved<br />
          You're receiving this email because an account recovery was requested for {{ username }}.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bottom spacer -->
    <mj-section padding="0 0 32px 0" background-color="#f3f4f6">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
